# (실습 예제_Ex2). 횟수 제어 반복#1
# 1부터 100까지의 합을 구하는 프로그램

sum = 0
for i in range(1, 101):
    sum += i
print("1부터 100까지의 합은",sum,"입니다.")


# (실습 예제_Ex3). 조건 제어 반복#1
# 1부터 100까지의 합을 구하는 프로그램

count = 1
sum = 0
while count <= 100 :
    sum = sum + count
    count = count + 1
print("1부터 100까지의 합은",sum,"입니다.")

# (실습 예제_Ex4). 횟수 제어 반복#2
# 팩토리얼 계산 프로그램

n = int(input("정수를 입력하시오: "))
fact = 1

for a in range(1, n + 1):		
    fact = fact * a

print(n, "!은", fact, "이다.")

